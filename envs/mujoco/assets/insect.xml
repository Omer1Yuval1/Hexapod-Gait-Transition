
<mujoco model="insect">
    <compiler angle="degree" coordinate="local" inertiafromgeom="true" settotalmass="0.1"/>
    <option gravity="0 0 -980" integrator="RK4" timestep="0.001" noslip_iterations="3" />
    
    <default>
        <joint armature="1" frictionloss="0.1" limited="true" margin="0" stiffness="20" damping="2" />
        <geom solref="0.0002 1" solimp="0.95 0.99 0.01" mass="0.01" condim="3" contype="2" conaffinity="1" rgba="0.8 0.6 0.4 1" friction="0" margin="0.01" gap="0" />
    </default>
    
    <visual>
        <scale jointwidth="0.05" jointlength="1" />
    </visual>
    
    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="512" height="512"/>
        <material name="MatPlane" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    	<include file="bodies/mole_cricket/mesh.xml" />
    </asset>
    
    <worldbody>
        <light cutoff="100" diffuse="1 1 1" dir="0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1"/>
        
        <camera name="worldview_0" mode="fixed" pos="0.0 -10.0 25.0" euler="45 0 0"/>
        <camera name="worldview_bwd" mode="fixed" pos="0.0 10.0 25.0" euler="-45 0 180"/>
        <camera name="worldview_1" mode="fixed" pos="-10.0 0.0 0.5" euler="90 -90 0"/>
        
        <geom contype="1" conaffinity="2" condim="3" mass="4" friction="1 0.005 0.0001" material="MatPlane" name="floor" pos="0 0 0" rgba="0.8 0.9 0.8 1" size="100 100 2" type="plane"/>
        
        <include file="bodies/mole_cricket/body.xml" />
    	</worldbody>

	<actuator>
		<motor name="Motor_L1_0" ctrllimited="true" ctrlrange="-1 1" joint="L1_0_joint" gear="200"/>
		<motor name="Motor_L1_1" ctrllimited="true" ctrlrange="-1 1" joint="L1_1_joint" gear="200"/>
		<motor name="Motor_L1_2" ctrllimited="true" ctrlrange="-1 1" joint="L1_2_joint" gear="200"/>
		<motor name="Motor_L1_3" ctrllimited="true" ctrlrange="-1 1" joint="L1_3_joint" gear="200"/>
		<motor name="Motor_R1_0" ctrllimited="true" ctrlrange="-1 1" joint="R1_0_joint" gear="200"/>
		<motor name="Motor_R1_1" ctrllimited="true" ctrlrange="-1 1" joint="R1_1_joint" gear="200"/>
		<motor name="Motor_R1_2" ctrllimited="true" ctrlrange="-1 1" joint="R1_2_joint" gear="200"/>
		<motor name="Motor_R1_3" ctrllimited="true" ctrlrange="-1 1" joint="R1_3_joint" gear="200"/>
		<motor name="Motor_L2_0" ctrllimited="true" ctrlrange="-1 1" joint="L2_0_joint" gear="200"/>
		<motor name="Motor_L2_1" ctrllimited="true" ctrlrange="-1 1" joint="L2_1_joint" gear="200"/>
		<motor name="Motor_L2_2" ctrllimited="true" ctrlrange="-1 1" joint="L2_2_joint" gear="200"/>
		<motor name="Motor_L2_3" ctrllimited="true" ctrlrange="-1 1" joint="L2_3_joint" gear="200"/>
		<motor name="Motor_R2_0" ctrllimited="true" ctrlrange="-1 1" joint="R2_0_joint" gear="200"/>
		<motor name="Motor_R2_1" ctrllimited="true" ctrlrange="-1 1" joint="R2_1_joint" gear="200"/>
		<motor name="Motor_R2_2" ctrllimited="true" ctrlrange="-1 1" joint="R2_2_joint" gear="200"/>
		<motor name="Motor_R2_3" ctrllimited="true" ctrlrange="-1 1" joint="R2_3_joint" gear="200"/>
		<motor name="Motor_L3_0" ctrllimited="true" ctrlrange="-1 1" joint="L3_0_joint" gear="200"/>
		<motor name="Motor_L3_1" ctrllimited="true" ctrlrange="-1 1" joint="L3_1_joint" gear="200"/>
		<motor name="Motor_L3_2" ctrllimited="true" ctrlrange="-1 1" joint="L3_2_joint" gear="200"/>
		<motor name="Motor_L3_3" ctrllimited="true" ctrlrange="-1 1" joint="L3_3_joint" gear="200"/>
		<motor name="Motor_R3_0" ctrllimited="true" ctrlrange="-1 1" joint="R3_0_joint" gear="200"/>
		<motor name="Motor_R3_1" ctrllimited="true" ctrlrange="-1 1" joint="R3_1_joint" gear="200"/>
		<motor name="Motor_R3_2" ctrllimited="true" ctrlrange="-1 1" joint="R3_2_joint" gear="200"/>
		<motor name="Motor_R3_3" ctrllimited="true" ctrlrange="-1 1" joint="R3_3_joint" gear="200"/>
    </actuator>
</mujoco>